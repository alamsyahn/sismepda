DATABASE_URL="postgresql://sismepda:ganti-password-kuat@localhost:5432/sismepda"
AUTH_SECRET="buat-dengan-openssl-rand-base64-32"
SEED_ADMIN_EMAIL="admin@sismepda.sch.id"
SEED_ADMIN_PASSWORD="ganti-password-kuat"

# Akun uji khusus development/local (npm run db:ensure-test-user).
# Jangan pernah diaktifkan pada environment produksi.
ALLOW_LOCAL_TEST_USER="false"
DEV_TEST_USER_EMAIL="hermes.test@sismepda.test"
DEV_TEST_USER_PASSWORD="isi-di-.env-lokal-minimal-12-karakter"
DEV_TEST_USER_NAME="Akun Uji Lokal"

# Data uji (synthetic) E-UKS khusus development/local.
# npm run dev:euks-seed / dev:euks-clear / dev:bootstrap
# JANGAN PERNAH diaktifkan pada environment produksi.
ALLOW_EUKS_TEST_DATA="false"
# Konfirmasi eksplisit nama database development tujuan; harus sama persis
# dengan nama database pada DATABASE_URL, jika tidak script menolak berjalan.
EXPECTED_DEV_DATABASE_NAME="sismepda_dev"

