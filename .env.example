DATABASE_URL="postgresql://sismepda:ganti-password-kuat@localhost:5432/sismepda"
AUTH_SECRET="buat-dengan-openssl-rand-base64-32"
SEED_ADMIN_EMAIL="admin@sismepda.sch.id"
SEED_ADMIN_PASSWORD="ganti-password-kuat"

# Akun uji khusus development/local (npm run db:ensure-test-user).
# Jangan pernah diaktifkan pada environment produksi.
ALLOW_LOCAL_TEST_USER="false"
DEV_TEST_USER_EMAIL="hermes.test@sismepda.test"
DEV_TEST_USER_PASSWORD="isi-di-.env-lokal-minimal-12-karakter"
DEV_TEST_USER_NAME="Akun Uji Lokal"

# Data uji (synthetic) E-UKS khusus development/local.
# npm run dev:euks-seed / dev:euks-clear / dev:bootstrap
# JANGAN PERNAH diaktifkan pada environment produksi.
ALLOW_EUKS_TEST_DATA="false"
# Konfirmasi eksplisit nama database development tujuan; harus sama persis
# dengan nama database pada DATABASE_URL, jika tidak script menolak berjalan.
EXPECTED_DEV_DATABASE_NAME="sismepda_dev"

# Origin tepercaya untuk mutasi yang mengubah kewenangan (RBAC, akun, profil).
# Permintaan dengan header Origin/Referer di luar daftar ini ditolak 403.
#
# Di development nilai ini boleh kosong: localhost dipercaya sebagai fallback.
# Di PRODUKSI nilai ini WAJIB diisi — bila kosong, verifikasi gagal-tertutup dan
# SELURUH mutasi kewenangan akan ditolak. Isi dengan skema + host + port persis
# seperti yang dilihat browser, tanpa garis miring akhir.
# Beberapa origin dipisahkan koma (mis. domain utama dan domain alias).
APP_ORIGIN=""

# Akar penyimpanan media kanonik (foto pengguna, logo, media E-UKS/Sarpras).
#
# BIARKAN KOSONG untuk pengembangan. Bila kosong, akar dipilih otomatis menurut
# peran database yang sedang aktif, sehingga `dev:local` dan `dev:prodclone`
# tidak pernah saling menimpa media:
#
#   dev:local       → .media/local
#   dev:prodclone   → .media/prodclone
#
# Direktori `.media/` sudah diabaikan Git. Mengisi variabel ini akan MEMATIKAN
# pemisahan tersebut: kedua peran memakai satu akar yang sama.
#
# Jangan arahkan ke direktori yang isinya tidak boleh terhapus: script/test
# hanya menulis, tetapi salah ketik di sini berarti media ditulis ke tempat tak
# terduga. Di produksi nilainya diisi lewat compose (volume `media`).
MEDIA_STORAGE_ROOT=""
