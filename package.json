    "media:migrate:local": "tsx scripts/with-db.ts local -- tsx scripts/migrate-media.ts",
    "media:migrate:verify:local": "tsx scripts/with-db.ts local -- tsx scripts/verify-media-migration.ts",
    "media:migrate:production": "tsx scripts/migrate-media-production.ts",
    "media:backup:create": "tsx scripts/media-backup.ts create",
    "media:backup:verify": "tsx scripts/media-backup.ts verify",
    "media:backup:restore-test": "tsx scripts/media-backup.ts restore-test",
    "backup:production": "tsx scripts/backup-production.ts",
    "backup:production:verify": "tsx scripts/backup-production.ts --verify",
    "db:rbac-backfill": "tsx prisma/rbac-backfill-legacy.ts",
    "db:analyze-legacy-dates:prodclone": "tsx scripts/analyze-legacy-dates.ts",
    "deploy:check": "tsx scripts/deploy.ts check",
    "deploy:preflight": "tsx scripts/deploy.ts preflight",
    "deploy:prod": "tsx scripts/deploy.ts deploy",
    "deploy:status": "tsx scripts/deploy.ts status",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/**/*.test.ts",
    "postinstall": "prisma generate",
    "whatsapp:worker:local": "tsx scripts/with-db.ts local -- tsx scripts/whatsapp-worker.mts"
