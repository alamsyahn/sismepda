    "db:seed:local": "tsx scripts/with-db.ts local -- prisma db seed",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:studio:local": "tsx scripts/with-db.ts local -- prisma studio",
    "db:ensure-test-user:local": "tsx scripts/with-db.ts local -- tsx scripts/ensure-local-test-user.ts",
    "db:bootstrap:local": "tsx scripts/with-db.ts local -- tsx scripts/dev-bootstrap.ts",
    "db:studio:prodclone": "tsx scripts/with-db.ts prodclone -- prisma studio",
    "db:prodclone:refresh": "tsx scripts/refresh-prodclone.ts",
    "media:prodclone:sync": "tsx scripts/sync-prodclone-media.ts",
    "prodclone:refresh": "tsx scripts/refresh-prodclone-all.ts",
    "euks:seed:local": "tsx scripts/with-db.ts local -- tsx scripts/generate-euks-test-data.ts",
    "euks:clear:local": "tsx scripts/with-db.ts local -- tsx scripts/clear-euks-test-data.ts",
    "euks:seed:prodclone": "tsx scripts/with-db.ts prodclone -- tsx scripts/generate-euks-test-data.ts",
