# Hostname publik tanpa https://
DOMAIN=app.smpn2blitar.sch.id

# Gunakan kredensial PostgreSQL produksi yang sudah ada. Jangan commit nilai nyata.
# Host "db" adalah alias container pada network sismepda-dashboard_internal.
DATABASE_URL=postgresql://sismepda:GANTI_DENGAN_PASSWORD_YANG_SUDAH_ADA@db:5432/sismepda

# Gunakan kembali AUTH_SECRET deployment lama agar sesi/auth tetap kompatibel.
AUTH_SECRET=GANTI_DENGAN_AUTH_SECRET_YANG_SUDAH_ADA

# Seed hanya membuat admin bila email ini belum ada; gunakan identitas admin yang ada.
SEED_ADMIN_EMAIL=admin@sismepda.sch.id
SEED_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_YANG_SUDAH_ADA

# Compose produksi memakai database dan edge proxy bersama yang sudah ada.
COMPOSE_FILE=compose.yaml:compose.edge.yaml

# Akar media DI DALAM container; harus sama dengan target mount volume `media`
# pada compose.yaml. Media TIDAK berada di volume database, sehingga backup
# PostgreSQL saja bukan lagi backup aplikasi yang lengkap — lihat
# docs/architecture/media-storage.md.
MEDIA_STORAGE_ROOT=/app/media
