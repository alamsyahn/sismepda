generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
  DISPENSASI
}

enum EmploymentStatus {
  PNS
  PPPK
  HONORER
}

enum WorkbookItemStatus {
  UNREVIEWED
  PRESENT
  MISSING
}

model User {
  id String @id @default(cuid())
  email String? @unique
  nip String? @unique
  passwordHash String
  name String
  phone String?
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  role Role @default(GURU)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  homeroomClass SchoolClass?
  submissions AttendanceDay[]
  violationPoints StudentViolationPoint[]
  canManageTeacherProfiles Boolean @default(false)
  employmentStatus EmploymentStatus?
  position String?
  teachingSince DateTime?
  belajarId String?
  teacherSubjects TeacherSubject[]
  teachingAssignments TeachingAssignment[]
  additionalDuties AdditionalDuty[]
  canSuperviseWorkbooks Boolean @default(false)
  canViewWorkbookSupervision Boolean @default(false)
  workbookSupervised Boolean @default(true)
  workbookLinks TeacherWorkbook[]
  workbookItemStatuses TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusTeacher")
  workbookReviews TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusReviewer")
  auditLogs AuditLog[]
}

model Subject {
  id String @id @default(cuid())
  name String @unique
  teacherSubjects TeacherSubject[]
  assignments TeachingAssignment[]
}

model TeacherSubject {
  id String @id @default(cuid())
  userId String
  subjectId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([userId, subjectId])
}

model TeachingAssignment {
  id String @id @default(cuid())
  userId String
  classId String
  subjectId String
  day Int
  periodStart Int
  periodEnd Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([userId, day, periodStart])
}

model AdditionalDuty {
  id String @id @default(cuid())
  userId String
  title String
  note String?
  startDate DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SchoolClass {
  id String @id @default(cuid())
  name String @unique
  grade String
  homeroomUserId String? @unique
  homeroomUser User? @relation(fields: [homeroomUserId], references: [id], onDelete: SetNull)
  students Student[]
  attendanceDays AttendanceDay[]
  teachingAssignments TeachingAssignment[]
}

model Student {
  id String @id @default(cuid())
  nis String? @unique
  nisn String? @unique
  name String
  active Boolean @default(true)
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  attendances Attendance[]
  violationPoints StudentViolationPoint[]
}

model StudentViolationPoint {
  id String @id @default(cuid())
  studentId String
  recordedById String
  category String
  points Int
  note String?
  occurredAt DateTime
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([studentId, occurredAt])
}

model AttendanceDay {
  id String @id @default(cuid())
  date DateTime
  classId String
  submittedById String
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])
  attendances Attendance[]
  @@unique([classId, date])
}

model Attendance {
  id String @id @default(cuid())
  attendanceDayId String
  studentId String
  status AttendanceStatus
  note String?
  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  @@unique([attendanceDayId, studentId])
}

model SchoolSetting {
  id String @id @default("default")
  websiteTitle String @default("SISMEPDA — Dashboard Absensi Sekolah")
  faviconData Bytes?
  faviconMimeType String?
  faviconUpdatedAt DateTime?
  schoolName String @default("SMP Negeri 1 Contoh")
  npsn String?
  academicYear String @default("2025/2026")
  semester String @default("Ganjil")
  attendanceOpenTime String @default("06:30")
  attendanceCloseTime String @default("08:00")
  autoLock Boolean @default(true)
  allowTeachersAccessAllClasses Boolean @default(false)
}

model SchoolHoliday {
  id String @id @default(cuid())
  date DateTime @unique
  name String
  createdAt DateTime @default(now())
}

model Workbook {
  id String @id @default(cuid())
  number Int @unique
  name String
  weight Int @default(25)
  sortOrder Int
  items WorkbookItem[]
  teacherWorkbooks TeacherWorkbook[]
}

model WorkbookItem {
  id String @id @default(cuid())
  workbookId String
  name String
  sortOrder Int
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  statuses TeacherWorkbookItemStatus[]
  @@unique([workbookId, sortOrder])
  @@index([workbookId])
}

model TeacherWorkbook {
  id String @id @default(cuid())
  userId String
  workbookId String
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  @@unique([userId, workbookId])
  @@index([workbookId])
}

model TeacherWorkbookItemStatus {
  id String @id @default(cuid())
  userId String
  workbookItemId String
  status WorkbookItemStatus @default(UNREVIEWED)
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("WorkbookItemStatusTeacher", fields: [userId], references: [id], onDelete: Cascade)
  workbookItem WorkbookItem @relation(fields: [workbookItemId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WorkbookItemStatusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@unique([userId, workbookItemId])
  @@index([userId])
  @@index([workbookItemId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String
  targetUserId String?
  summary String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}
