generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
}

/// Jenis kelamin siswa. Diperlukan untuk klasifikasi IMT-menurut-umur
/// (kurva pertumbuhan berbeda antara laki-laki dan perempuan).
enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
  DISPENSASI
}

enum EmploymentStatus {
  PNS
  PPPK
  HONORER
}

enum WorkbookItemStatus {
  UNREVIEWED
  PRESENT
  MISSING
}

model User {
  id String @id @default(cuid())
  email String? @unique
  nip String? @unique
  passwordHash String
  name String
  phone String?
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  role Role @default(GURU)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  homeroomClass SchoolClass?
  submissions AttendanceDay[]
  violationPoints StudentViolationPoint[]
  canManageTeacherProfiles Boolean @default(false)
  employmentStatus EmploymentStatus?
  position String?
  teachingSince DateTime? @db.Date
  belajarId String?
  teacherSubjects TeacherSubject[]
  teachingAssignments TeachingAssignment[]
  additionalDuties AdditionalDuty[]
  canSuperviseWorkbooks Boolean @default(false)
  canViewWorkbookSupervision Boolean @default(false)
  workbookSupervised Boolean @default(true)
  workbookLinks TeacherWorkbook[]
  workbookItemStatuses TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusTeacher")
  workbookReviews TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusReviewer")
  auditLogs AuditLog[]
  canViewBos Boolean @default(false)
  canCreateBos Boolean @default(false)
  canEditBos Boolean @default(false)
  canManageBosCategories Boolean @default(false)
  canManageBosAccess Boolean @default(false)
  bosEntriesCreated BosEntry[] @relation("BosEntryCreator")
  bosEntriesUpdated BosEntry[] @relation("BosEntryUpdater")
  canViewSarpras Boolean @default(false)
  canEditSarpras Boolean @default(false)
  sarprasItemsCreated SarprasItem[] @relation("SarprasItemCreator")
  sarprasItemsUpdated SarprasItem[] @relation("SarprasItemUpdater")
  sarprasHistories SarprasHistory[] @relation("SarprasHistoryActor")
  canViewEuks Boolean @default(false)
  canEditEuks Boolean @default(false)
  euksVisitsRecorded EuksVisit[] @relation("EuksVisitRecorder")
  healthMeasurementsRecorded StudentHealthMeasurement[] @relation("HealthMeasurementRecorder")
  euksOfficerRoles EuksOfficer[] @relation("EuksOfficerUser")
}

model Subject {
  id String @id @default(cuid())
  name String @unique
  teacherSubjects TeacherSubject[]
  assignments TeachingAssignment[]
}

model TeacherSubject {
  id String @id @default(cuid())
  userId String
  subjectId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([userId, subjectId])
}

model TeachingAssignment {
  id String @id @default(cuid())
  userId String
  classId String
  subjectId String
  day Int
  periodStart Int
  periodEnd Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([userId, day, periodStart])
}

model AdditionalDuty {
  id String @id @default(cuid())
  userId String
  title String
  note String?
  startDate DateTime? @db.Date
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SchoolClass {
  id String @id @default(cuid())
  name String @unique
  grade String
  homeroomUserId String? @unique
  homeroomUser User? @relation(fields: [homeroomUserId], references: [id], onDelete: SetNull)
  students Student[]
  attendanceDays AttendanceDay[]
  teachingAssignments TeachingAssignment[]
}

model Student {
  id String @id @default(cuid())
  nis String? @unique
  nisn String? @unique
  name String
  active Boolean @default(true)
  /// Tanggal lahir — dasar perhitungan umur untuk IMT-menurut-umur.
  /// Nullable: data historis belum memilikinya.
  birthDate DateTime? @db.Date
  /// Nullable untuk alasan yang sama seperti birthDate.
  gender Gender?
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  attendances Attendance[]
  violationPoints StudentViolationPoint[]
  euksVisits EuksVisit[]
  healthMeasurements StudentHealthMeasurement[]
}

model StudentViolationPoint {
  id String @id @default(cuid())
  studentId String
  recordedById String
  category String
  points Int
  note String?
  occurredAt DateTime @db.Date
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([studentId, occurredAt])
}

/// Satu kunjungan siswa ke UKS. Menjadi source of truth untuk riwayat
/// kunjungan, tren keluhan, dan statistik tindakan pada modul E-UKS.
model EuksVisit {
  id String @id @default(cuid())
  studentId String
  /// Tanggal kunjungan — tanggal sekolah, bukan timestamp.
  occurredAt DateTime @db.Date
  complaint String
  treatment String
  followUp String?
  recordedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("EuksVisitRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([studentId, occurredAt])
}

/// Satu kali pengukuran tinggi & berat badan siswa. Historis: setiap
/// pengukuran menjadi baris baru sehingga tren IMT dapat dihitung.
/// IMT tidak pernah disimpan — selalu diturunkan dari tinggi & berat.
model StudentHealthMeasurement {
  id String @id @default(cuid())
  studentId String
  /// Tanggal pengukuran — tanggal sekolah, bukan timestamp.
  measuredAt DateTime @db.Date
  /// Tinggi badan dalam sentimeter.
  heightCm Decimal @db.Decimal(5, 1)
  /// Berat badan dalam kilogram.
  weightKg Decimal @db.Decimal(5, 1)
  note String?
  recordedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("HealthMeasurementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, measuredAt])
  @@index([studentId, measuredAt])
}

/// Identitas UKS untuk Halaman Utama. Singleton — satu baris, id "default",
/// mengikuti pola BosSetting.
model EuksProfile {
  id String @id @default("default")
  /// Nama unit; null selama admin belum mengisi.
  name String?
  /// Deskripsi singkat/visi-misi, teks bebas multi-baris.
  description String?
  /// Lokasi ruang UKS di lingkungan sekolah.
  location String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Pengurus UKS. Boleh menunjuk User (guru) atau diisi manual untuk siswa
/// dan pihak luar yang tidak punya akun — karena itu userId nullable dan
/// name selalu tersimpan sebagai teks.
model EuksOfficer {
  id String @id @default(cuid())
  /// Guru terkait, bila pengurus ini punya akun. SetNull agar menghapus akun
  /// tidak ikut menghapus riwayat kepengurusan.
  userId String?
  /// Nama tampil. Untuk pengurus bertaut guru, disalin saat disimpan supaya
  /// kartu tetap terbaca bila akunnya dinonaktifkan.
  name String
  /// Jabatan dalam struktur UKS, mis. "Pembina", "Ketua".
  role String
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation("EuksOfficerUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
}

/// Fasilitas/perlengkapan UKS yang ditampilkan di Halaman Utama.
/// Ini daftar informatif, bukan inventaris — stok barang adalah ranah Sarpras.
model EuksFacility {
  id String @id @default(cuid())
  name String
  /// Lowercase + spasi dirapikan; mencegah duplikat "Tandu"/"tandu"/" Tandu ".
  slug String @unique
  /// Jumlah unit bila relevan; null berarti tidak dihitung.
  quantity Int?
  note String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Daftar keluhan siap-pilih untuk form kunjungan. Tujuannya menyeragamkan
/// ejaan agar statistik Halaman Utama tidak terpecah; petugas tetap boleh
/// mengetik keluhan di luar daftar ini.
model EuksComplaintOption {
  id String @id @default(cuid())
  label String
  /// Lowercase + spasi dirapikan; kunci yang sama dipakai agregasi tren.
  slug String @unique
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model AttendanceDay {
  id String @id @default(cuid())
  date DateTime @db.Date
  classId String
  submittedById String
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])
  attendances Attendance[]
  @@unique([classId, date])
}

model Attendance {
  id String @id @default(cuid())
  attendanceDayId String
  studentId String
  status AttendanceStatus
  note String?
  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  @@unique([attendanceDayId, studentId])
}

model SchoolSetting {
  id String @id @default("default")
  websiteTitle String @default("SISMEPDA — Dashboard Absensi Sekolah")
  faviconData Bytes?
  faviconMimeType String?
  faviconUpdatedAt DateTime?
  appName String @default("SISMEPDA")
  appFullName String @default("Sistem Informasi Sekolah")
  appLogoData Bytes?
  appLogoMimeType String?
  appLogoUpdatedAt DateTime?
  schoolName String @default("SMP Negeri 1 Contoh")
  npsn String?
  academicYear String @default("2025/2026")
  semester String @default("Ganjil")
  timeZone String @default("Asia/Jakarta")
  attendanceOpenTime String @default("06:30")
  attendanceCloseTime String @default("08:00")
  autoLock Boolean @default(true)
  allowTeachersAccessAllClasses Boolean @default(false)
  attendanceStatusColors String?
}

model SchoolHoliday {
  id String @id @default(cuid())
  date DateTime @db.Date @unique
  name String
  createdAt DateTime @default(now())
}

model Workbook {
  id String @id @default(cuid())
  number Int @unique
  name String
  weight Int @default(25)
  sortOrder Int
  items WorkbookItem[]
  teacherWorkbooks TeacherWorkbook[]
}

model WorkbookItem {
  id String @id @default(cuid())
  workbookId String
  name String
  sortOrder Int
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  statuses TeacherWorkbookItemStatus[]
  @@unique([workbookId, sortOrder])
  @@index([workbookId])
}

model TeacherWorkbook {
  id String @id @default(cuid())
  userId String
  workbookId String
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  @@unique([userId, workbookId])
  @@index([workbookId])
}

model TeacherWorkbookItemStatus {
  id String @id @default(cuid())
  userId String
  workbookItemId String
  status WorkbookItemStatus @default(UNREVIEWED)
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("WorkbookItemStatusTeacher", fields: [userId], references: [id], onDelete: Cascade)
  workbookItem WorkbookItem @relation(fields: [workbookItemId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WorkbookItemStatusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@unique([userId, workbookItemId])
  @@index([userId])
  @@index([workbookItemId])
}

/** Single-row configuration for the BOS module (mirrors SchoolSetting). */
model BosSetting {
  id String @id @default("default")
  /** Anggaran awal; null selama belum diisi admin. */
  initialBudget Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BosCategory {
  id String @id @default(cuid())
  name String
  /** Lowercase + whitespace-collapsed name; blocks "ATK" / "atk" / " ATK " duplicates. */
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries BosEntry[]
}

model BosEntry {
  id String @id @default(cuid())
  categoryId String
  description String
  occurredAt DateTime @db.Date
  /** Realisasi rupiah — decimal, never float. */
  amount Decimal @db.Decimal(14, 2)
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category BosCategory @relation(fields: [categoryId], references: [id])
  createdBy User? @relation("BosEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BosEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  documents BosDocument[]
  @@index([categoryId])
  @@index([occurredAt])
}

model BosDocument {
  id String @id @default(cuid())
  entryId String
  label String?
  url String
  createdAt DateTime @default(now())
  entry BosEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String
  targetUserId String?
  summary String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum SarprasPriority {
  HIGH
  MEDIUM
  LOW
}

/// Lokasi sarpras berbentuk tree bebas kedalaman (Gedung > Lantai > Ruang > Area).
/// Sebuah node boleh memiliki child DAN barang sekaligus.
model SarprasLocation {
  id String @id @default(cuid())
  name String
  slug String
  parentId String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent SarprasLocation? @relation("SarprasLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children SarprasLocation[] @relation("SarprasLocationTree")
  items SarprasItem[]
  /// Nama unik per induk: "VII A" boleh ada di bawah Kelas dan di bawah Gedung B.
  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
}

/// Master jenis barang (CCTV, Proyektor, Kursi Siswa) supaya nama tidak diketik ulang.
model SarprasItemType {
  id String @id @default(cuid())
  name String
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items SarprasItem[]
}

/// Kebutuhan satu jenis barang pada satu lokasi.
model SarprasItem {
  id String @id @default(cuid())
  locationId String
  itemTypeId String
  targetQuantity Int @default(0)
  availableQuantity Int @default(0)
  goodQuantity Int @default(0)
  moderateQuantity Int @default(0)
  repairQuantity Int @default(0)
  acquisitionDate DateTime? @db.Date
  inventoryCode String?
  description String?
  priority SarprasPriority?
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  location SarprasLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemType SarprasItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("SarprasItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SarprasItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  photos SarprasPhoto[]
  histories SarprasHistory[]
  /// Satu baris per jenis barang per lokasi; perubahan jumlah cukup di-update.
  @@unique([locationId, itemTypeId])
  @@index([locationId])
  @@index([itemTypeId])
}

/// Foto barang disimpan sebagai bytes, mengikuti pola User.photoData.
model SarprasPhoto {
  id String @id @default(cuid())
  itemId String
  data Bytes
  mimeType String
  caption String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId, sortOrder])
}

/// Riwayat perubahan jumlah/kondisi satu barang, untuk panel detail.
model SarprasHistory {
  id String @id @default(cuid())
  itemId String
  actorId String?
  summary String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User? @relation("SarprasHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([itemId, createdAt])
}
