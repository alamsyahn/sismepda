generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GURU
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
  DISPENSASI
}

enum EmploymentStatus {
  PNS
  PPPK
  HONORER
}

enum WorkbookItemStatus {
  UNREVIEWED
  PRESENT
  MISSING
}

model User {
  id String @id @default(cuid())
  email String? @unique
  nip String? @unique
  passwordHash String
  name String
  phone String?
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  role Role @default(GURU)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  homeroomClass SchoolClass?
  submissions AttendanceDay[]
  violationPoints StudentViolationPoint[]
  canManageTeacherProfiles Boolean @default(false)
  employmentStatus EmploymentStatus?
  position String?
  teachingSince DateTime?
  belajarId String?
  teacherSubjects TeacherSubject[]
  teachingAssignments TeachingAssignment[]
  additionalDuties AdditionalDuty[]
  canSuperviseWorkbooks Boolean @default(false)
  canViewWorkbookSupervision Boolean @default(false)
  workbookSupervised Boolean @default(true)
  workbookLinks TeacherWorkbook[]
  workbookItemStatuses TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusTeacher")
  workbookReviews TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusReviewer")
  auditLogs AuditLog[]
  canViewBos Boolean @default(false)
  canCreateBos Boolean @default(false)
  canEditBos Boolean @default(false)
  canManageBosCategories Boolean @default(false)
  canManageBosAccess Boolean @default(false)
  bosEntriesCreated BosEntry[] @relation("BosEntryCreator")
  bosEntriesUpdated BosEntry[] @relation("BosEntryUpdater")
  canViewSarpras Boolean @default(false)
  canEditSarpras Boolean @default(false)
  sarprasItemsCreated SarprasItem[] @relation("SarprasItemCreator")
  sarprasItemsUpdated SarprasItem[] @relation("SarprasItemUpdater")
  sarprasHistories SarprasHistory[] @relation("SarprasHistoryActor")
}

model Subject {
  id String @id @default(cuid())
  name String @unique
  teacherSubjects TeacherSubject[]
  assignments TeachingAssignment[]
}

model TeacherSubject {
  id String @id @default(cuid())
  userId String
  subjectId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([userId, subjectId])
}

model TeachingAssignment {
  id String @id @default(cuid())
  userId String
  classId String
  subjectId String
  day Int
  periodStart Int
  periodEnd Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([userId, day, periodStart])
}

model AdditionalDuty {
  id String @id @default(cuid())
  userId String
  title String
  note String?
  startDate DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SchoolClass {
  id String @id @default(cuid())
  name String @unique
  grade String
  homeroomUserId String? @unique
  homeroomUser User? @relation(fields: [homeroomUserId], references: [id], onDelete: SetNull)
  students Student[]
  attendanceDays AttendanceDay[]
  teachingAssignments TeachingAssignment[]
}

model Student {
  id String @id @default(cuid())
  nis String? @unique
  nisn String? @unique
  name String
  active Boolean @default(true)
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  attendances Attendance[]
  violationPoints StudentViolationPoint[]
}

model StudentViolationPoint {
  id String @id @default(cuid())
  studentId String
  recordedById String
  category String
  points Int
  note String?
  occurredAt DateTime
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([studentId, occurredAt])
}

model AttendanceDay {
  id String @id @default(cuid())
  date DateTime
  classId String
  submittedById String
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])
  attendances Attendance[]
  @@unique([classId, date])
}

model Attendance {
  id String @id @default(cuid())
  attendanceDayId String
  studentId String
  status AttendanceStatus
  note String?
  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  @@unique([attendanceDayId, studentId])
}

model SchoolSetting {
  id String @id @default("default")
  websiteTitle String @default("SISMEPDA — Dashboard Absensi Sekolah")
  faviconData Bytes?
  faviconMimeType String?
  faviconUpdatedAt DateTime?
  appName String @default("SISMEPDA")
  appFullName String @default("Sistem Informasi Sekolah")
  appLogoData Bytes?
  appLogoMimeType String?
  appLogoUpdatedAt DateTime?
  schoolName String @default("SMP Negeri 1 Contoh")
  npsn String?
  academicYear String @default("2025/2026")
  semester String @default("Ganjil")
  attendanceOpenTime String @default("06:30")
  attendanceCloseTime String @default("08:00")
  autoLock Boolean @default(true)
  allowTeachersAccessAllClasses Boolean @default(false)
  attendanceStatusColors String?
}

model SchoolHoliday {
  id String @id @default(cuid())
  date DateTime @unique
  name String
  createdAt DateTime @default(now())
}

model Workbook {
  id String @id @default(cuid())
  number Int @unique
  name String
  weight Int @default(25)
  sortOrder Int
  items WorkbookItem[]
  teacherWorkbooks TeacherWorkbook[]
}

model WorkbookItem {
  id String @id @default(cuid())
  workbookId String
  name String
  sortOrder Int
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  statuses TeacherWorkbookItemStatus[]
  @@unique([workbookId, sortOrder])
  @@index([workbookId])
}

model TeacherWorkbook {
  id String @id @default(cuid())
  userId String
  workbookId String
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  @@unique([userId, workbookId])
  @@index([workbookId])
}

model TeacherWorkbookItemStatus {
  id String @id @default(cuid())
  userId String
  workbookItemId String
  status WorkbookItemStatus @default(UNREVIEWED)
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("WorkbookItemStatusTeacher", fields: [userId], references: [id], onDelete: Cascade)
  workbookItem WorkbookItem @relation(fields: [workbookItemId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WorkbookItemStatusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@unique([userId, workbookItemId])
  @@index([userId])
  @@index([workbookItemId])
}

/** Single-row configuration for the BOS module (mirrors SchoolSetting). */
model BosSetting {
  id String @id @default("default")
  /** Anggaran awal; null selama belum diisi admin. */
  initialBudget Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BosCategory {
  id String @id @default(cuid())
  name String
  /** Lowercase + whitespace-collapsed name; blocks "ATK" / "atk" / " ATK " duplicates. */
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries BosEntry[]
}

model BosEntry {
  id String @id @default(cuid())
  categoryId String
  description String
  occurredAt DateTime
  /** Realisasi rupiah — decimal, never float. */
  amount Decimal @db.Decimal(14, 2)
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category BosCategory @relation(fields: [categoryId], references: [id])
  createdBy User? @relation("BosEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BosEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  documents BosDocument[]
  @@index([categoryId])
  @@index([occurredAt])
}

model BosDocument {
  id String @id @default(cuid())
  entryId String
  label String?
  url String
  createdAt DateTime @default(now())
  entry BosEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String
  targetUserId String?
  summary String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum SarprasPriority {
  HIGH
  MEDIUM
  LOW
}

/// Lokasi sarpras berbentuk tree bebas kedalaman (Gedung > Lantai > Ruang > Area).
/// Sebuah node boleh memiliki child DAN barang sekaligus.
model SarprasLocation {
  id String @id @default(cuid())
  name String
  slug String
  parentId String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent SarprasLocation? @relation("SarprasLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children SarprasLocation[] @relation("SarprasLocationTree")
  items SarprasItem[]
  /// Nama unik per induk: "VII A" boleh ada di bawah Kelas dan di bawah Gedung B.
  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
}

/// Master jenis barang (CCTV, Proyektor, Kursi Siswa) supaya nama tidak diketik ulang.
model SarprasItemType {
  id String @id @default(cuid())
  name String
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items SarprasItem[]
}

/// Kebutuhan satu jenis barang pada satu lokasi.
model SarprasItem {
  id String @id @default(cuid())
  locationId String
  itemTypeId String
  targetQuantity Int @default(0)
  availableQuantity Int @default(0)
  goodQuantity Int @default(0)
  moderateQuantity Int @default(0)
  repairQuantity Int @default(0)
  acquisitionDate DateTime?
  inventoryCode String?
  description String?
  priority SarprasPriority?
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  location SarprasLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemType SarprasItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("SarprasItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SarprasItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  photos SarprasPhoto[]
  histories SarprasHistory[]
  /// Satu baris per jenis barang per lokasi; perubahan jumlah cukup di-update.
  @@unique([locationId, itemTypeId])
  @@index([locationId])
  @@index([itemTypeId])
}

/// Foto barang disimpan sebagai bytes, mengikuti pola User.photoData.
model SarprasPhoto {
  id String @id @default(cuid())
  itemId String
  data Bytes
  mimeType String
  caption String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId, sortOrder])
}

/// Riwayat perubahan jumlah/kondisi satu barang, untuk panel detail.
model SarprasHistory {
  id String @id @default(cuid())
  itemId String
  actorId String?
  summary String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User? @relation("SarprasHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([itemId, createdAt])
}
