generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Enum peran legacy. Simbol Prisma-nya bernama `LegacyRole` supaya nama `Role`
/// bisa dipakai model RBAC baru, tetapi tipe fisik PostgreSQL tetap `"Role"`
/// lewat @@map — tidak ada perubahan database untuk enum ini. Dihapus pada
/// Phase 6, bukan sekarang.
enum LegacyRole {
  ADMIN
  GURU

  @@map("Role")
}

/// Jenis kelamin siswa. Diperlukan untuk klasifikasi IMT-menurut-umur
/// (kurva pertumbuhan berbeda antara laki-laki dan perempuan).
enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALFA
  DISPENSASI
}

enum EmploymentStatus {
  PNS
  PPPK
  HONORER
}

enum WorkbookItemStatus {
  UNREVIEWED
  PRESENT
  MISSING
}

model User {
  id String @id @default(cuid())
  email String? @unique
  nip String? @unique
  passwordHash String
  name String
  phone String?
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  /// Kunci media di penyimpanan kanonik (lihat docs/architecture/media-storage.md).
  /// Aditif: `photoData` DIPERTAHANKAN sebagai fallback sampai produksi selesai
  /// dimigrasikan dan diverifikasi. Null berarti foto masih di kolom bytes.
  photoKey String?
  photoSize Int?
  role LegacyRole @default(GURU)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  homeroomClass SchoolClass?
  submissions AttendanceDay[]
  violationPoints StudentViolationPoint[]
  canManageTeacherProfiles Boolean @default(false)
  employmentStatus EmploymentStatus?
  position String?
  teachingSince DateTime? @db.Date
  belajarId String?
  teacherSubjects TeacherSubject[]
  teachingAssignments TeachingAssignment[]
  additionalDuties AdditionalDuty[]
  canSuperviseWorkbooks Boolean @default(false)
  canViewWorkbookSupervision Boolean @default(false)
  workbookSupervised Boolean @default(true)
  workbookLinks TeacherWorkbook[]
  workbookItemStatuses TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusTeacher")
  workbookReviews TeacherWorkbookItemStatus[] @relation("WorkbookItemStatusReviewer")
  auditLogs AuditLog[]
  canViewBos Boolean @default(false)
  canCreateBos Boolean @default(false)
  canEditBos Boolean @default(false)
  canManageBosCategories Boolean @default(false)
  canManageBosAccess Boolean @default(false)
  bosEntriesCreated BosEntry[] @relation("BosEntryCreator")
  bosEntriesUpdated BosEntry[] @relation("BosEntryUpdater")
  canViewSarpras Boolean @default(false)
  canEditSarpras Boolean @default(false)
  sarprasItemsCreated SarprasItem[] @relation("SarprasItemCreator")
  sarprasItemsUpdated SarprasItem[] @relation("SarprasItemUpdater")
  sarprasHistories SarprasHistory[] @relation("SarprasHistoryActor")
  canViewEuks Boolean @default(false)
  canEditEuks Boolean @default(false)
  euksVisitsRecorded EuksVisit[] @relation("EuksVisitRecorder")
  healthMeasurementsRecorded StudentHealthMeasurement[] @relation("HealthMeasurementRecorder")
  euksOfficerRoles EuksOfficer[] @relation("EuksOfficerUser")
  /// Menandai bahwa akun ini juga merupakan record guru (direktori, jadwal,
  /// wali kelas, buku kerja, kandidat pengurus UKS). Identitas bisnis, BUKAN
  /// konsep otorisasi: memegang role `guru` tidak menyalakan kolom ini, dan
  /// kolom ini tidak memberi permission apa pun. Backfill identitas legacy
  /// dilakukan Phase 3, jadi kode yang membacanya harus tetap benar saat
  /// seluruh baris masih false.
  isTeacher Boolean @default(false)
  /// Keanggotaan role RBAC. Kosong berarti tanpa permission — tidak ada role
  /// default implisit.
  rbacRoles UserRole[]
  rbacMigrationItems RbacMigrationItem[]
  /// Kiriman WhatsApp manual ("Kirim sekarang") yang dipicu akun ini.
  whatsAppSendsInitiated WhatsAppSendLog[]
  /// Modul Jadwal (lihat docs/features/jadwal.md).
  scheduleEntries ScheduleEntry[] @relation("ScheduleEntryTeacher")
  scheduleRevisionsCreated ScheduleRevision[] @relation("ScheduleRevisionAuthor")
  scheduleImportsUploaded ScheduleImport[] @relation("ScheduleImportUploader")
}

model Subject {
  id String @id @default(cuid())
  name String @unique
  teacherSubjects TeacherSubject[]
  assignments TeachingAssignment[]
  scheduleEntries ScheduleEntry[]
}

model TeacherSubject {
  id String @id @default(cuid())
  userId String
  subjectId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([userId, subjectId])
}

model TeachingAssignment {
  id String @id @default(cuid())
  userId String
  classId String
  subjectId String
  day Int
  periodStart Int
  periodEnd Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@index([userId, day, periodStart])
}

model AdditionalDuty {
  id String @id @default(cuid())
  userId String
  title String
  note String?
  startDate DateTime? @db.Date
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SchoolClass {
  id String @id @default(cuid())
  name String @unique
  grade String
  homeroomUserId String? @unique
  homeroomUser User? @relation(fields: [homeroomUserId], references: [id], onDelete: SetNull)
  students Student[]
  attendanceDays AttendanceDay[]
  teachingAssignments TeachingAssignment[]
  scheduleEntries ScheduleEntry[]
}

model Student {
  id String @id @default(cuid())
  nis String? @unique
  nisn String? @unique
  name String
  active Boolean @default(true)
  /// Tanggal lahir — dasar perhitungan umur untuk IMT-menurut-umur.
  /// Nullable: data historis belum memilikinya.
  birthDate DateTime? @db.Date
  /// Nullable untuk alasan yang sama seperti birthDate.
  gender Gender?
  /// Menandai bahwa `gender` dan/atau `birthDate` baris ini diisi oleh
  /// generator data uji development (`npm run euks:seed:local`), bukan data
  /// sekolah sesungguhnya. Generator hanya mengisi kolom yang masih NULL dan
  /// tidak pernah menimpa nilai asli; `euks:clear:*` mengembalikan kolom
  /// bertanda ini ke NULL. Selalu false pada produksi.
  syntheticDemographics Boolean @default(false)
  classId String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  attendances Attendance[]
  violationPoints StudentViolationPoint[]
  euksVisits EuksVisit[]
  healthMeasurements StudentHealthMeasurement[]
}

model StudentViolationPoint {
  id String @id @default(cuid())
  studentId String
  recordedById String
  category String
  points Int
  note String?
  occurredAt DateTime @db.Date
  createdAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([studentId, occurredAt])
}

/// Satu kunjungan siswa ke UKS. Menjadi source of truth untuk riwayat
/// kunjungan, tren keluhan, dan statistik tindakan pada modul E-UKS.
model EuksVisit {
  id String @id @default(cuid())
  studentId String
  /// Tanggal kunjungan — tanggal sekolah, bukan timestamp.
  occurredAt DateTime @db.Date
  complaint String
  treatment String
  followUp String?
  recordedById String?
  /// Data uji yang dibuat generator development. Selalu false untuk data
  /// nyata, sehingga penghapusan data uji dapat menyaring baris secara pasti.
  isSynthetic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("EuksVisitRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([isSynthetic])
  @@index([studentId, occurredAt])
}

/// Satu kali pengukuran tinggi & berat badan siswa. Historis: setiap
/// pengukuran menjadi baris baru sehingga tren IMT dapat dihitung.
/// IMT tidak pernah disimpan — selalu diturunkan dari tinggi & berat.
model StudentHealthMeasurement {
  id String @id @default(cuid())
  studentId String
  /// Tanggal pengukuran — tanggal sekolah, bukan timestamp.
  measuredAt DateTime @db.Date
  /// Tinggi badan dalam sentimeter.
  heightCm Decimal @db.Decimal(5, 1)
  /// Berat badan dalam kilogram.
  weightKg Decimal @db.Decimal(5, 1)
  note String?
  recordedById String?
  /// Data uji yang dibuat generator development; lihat EuksVisit.isSynthetic.
  isSynthetic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("HealthMeasurementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, measuredAt])
  @@index([isSynthetic])
  @@index([studentId, measuredAt])
}

/// Identitas UKS untuk Halaman Utama. Singleton — satu baris, id "default",
/// mengikuti pola BosSetting.
model EuksProfile {
  id String @id @default("default")
  /// Nama unit; null selama admin belum mengisi.
  name String?
  /// Deskripsi singkat/visi-misi, teks bebas multi-baris.
  description String?
  /// Lokasi ruang UKS di lingkungan sekolah.
  location String?
  /// Jam layanan UKS sebagai teks bebas, mis. "Senin–Sabtu, 07.00–14.00".
  /// Teks dan bukan rentang terstruktur: jadwal UKS tidak dipakai perhitungan
  /// apa pun, hanya ditampilkan pada kartu identitas Halaman Utama.
  serviceHours String?
  /// Kontak yang bisa dihubungi (nama petugas, nomor, atau ekstensi).
  contact String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Foto latar carousel hero Halaman Utama E-UKS.
///
/// Tabel tersendiri, bukan kolom pada EuksProfile, karena jumlah fotonya bebas
/// dan urutannya harus bisa diatur. Byte foto menumpang baris ini mengikuti
/// pola EuksOfficer/SarprasPhoto: tidak ada berkas di disk, sehingga tidak ada
/// nama file yang bertabrakan, tidak ada berkas yatim saat baris dihapus, dan
/// tidak ada direktori unggahan yang perlu dipasang di VPS/Docker.
model EuksHeroImage {
  id String @id @default(cuid())
  /// Keterangan opsional; dipakai sebagai teks alternatif bila diisi.
  caption String?
  /// Foto lanskap 16:9. Nullable karena baris dibuat lebih dulu, lalu byte
  /// diunggah pada permintaan kedua — unggahan gagal menyisakan baris tanpa
  /// foto, bukan record setengah tertulis.
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  photoKey String?
  photoSize Int?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Logo institusi yang ditumpuk di pojok kiri atas hero Halaman Utama E-UKS.
///
/// Tabel terpisah dari EuksHeroImage meskipun strukturnya mirip: logo adalah
/// lapisan statis dengan aturan tampilan berbeda (object-contain, tinggi
/// seragam, boleh SVG) sementara EuksHeroImage adalah foto latar 16:9 yang
/// dipotong cover dan tidak pernah SVG. Menggabungkan keduanya akan memaksa
/// satu kolom "peran" plus percabangan di setiap query dan setiap komponen.
model EuksHeroLogo {
  id String @id @default(cuid())
  /// Nama institusi; dipakai sebagai teks alternatif. Wajib terisi karena logo
  /// mewakili institusi, jadi tidak boleh jadi gambar tanpa makna.
  name String
  /// Byte logo. Nullable dengan alasan sama seperti EuksHeroImage: baris dibuat
  /// lebih dulu, byte menyusul pada permintaan kedua.
  logoData Bytes?
  /// Termasuk image/svg+xml, yang tidak berlaku untuk foto hero.
  logoMimeType String?
  logoUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  logoKey String?
  logoSize Int?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Pengurus UKS. Boleh menunjuk User (guru) atau diisi manual untuk siswa
/// dan pihak luar yang tidak punya akun — karena itu userId nullable dan
/// name selalu tersimpan sebagai teks.
model EuksOfficer {
  id String @id @default(cuid())
  /// Guru terkait, bila pengurus ini punya akun. SetNull agar menghapus akun
  /// tidak ikut menghapus riwayat kepengurusan.
  userId String?
  /// Nama tampil. Untuk pengurus bertaut guru, disalin saat disimpan supaya
  /// kartu tetap terbaca bila akunnya dinonaktifkan.
  name String
  /// Jabatan dalam struktur UKS, mis. "Pembina", "Ketua".
  role String
  /// Foto potret 9:16, disimpan sebagai bytes mengikuti pola User.photoData.
  /// Override milik modul UKS: tidak pernah menulis foto akun guru.
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  photoKey String?
  photoSize Int?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation("EuksOfficerUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder])
}

/// Fasilitas/perlengkapan UKS yang ditampilkan di Halaman Utama.
/// Ini daftar informatif, bukan inventaris — stok barang adalah ranah Sarpras.
model EuksFacility {
  id String @id @default(cuid())
  name String
  /// Lowercase + spasi dirapikan; mencegah duplikat "Tandu"/"tandu"/" Tandu ".
  slug String @unique
  /// Jumlah unit bila relevan; null berarti tidak dihitung.
  quantity Int?
  note String?
  /// Foto utama fasilitas (4:3), bytes seperti SarprasPhoto. Opsional.
  photoData Bytes?
  photoMimeType String?
  photoUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  photoKey String?
  photoSize Int?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// Daftar keluhan siap-pilih untuk form kunjungan. Tujuannya menyeragamkan
/// ejaan agar statistik Halaman Utama tidak terpecah; petugas tetap boleh
/// mengetik keluhan di luar daftar ini.
model EuksComplaintOption {
  id String @id @default(cuid())
  label String
  /// Lowercase + spasi dirapikan; kunci yang sama dipakai agregasi tren.
  slug String @unique
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model AttendanceDay {
  id String @id @default(cuid())
  date DateTime @db.Date
  classId String
  submittedById String
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  schoolClass SchoolClass @relation(fields: [classId], references: [id])
  submittedBy User @relation(fields: [submittedById], references: [id])
  attendances Attendance[]
  @@unique([classId, date])
}

model Attendance {
  id String @id @default(cuid())
  attendanceDayId String
  studentId String
  status AttendanceStatus
  note String?
  /// Tindak lanjut sekolah atas ketidakhadiran, diisi dari Pantauan Kesehatan
  /// E-UKS. Terpisah dari `note` yang berisi keterangan dari orang tua/siswa.
  followUp String?
  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  @@unique([attendanceDayId, studentId])
}

model SchoolSetting {
  id String @id @default("default")
  websiteTitle String @default("SISMEPDA — Dashboard Absensi Sekolah")
  faviconData Bytes?
  faviconMimeType String?
  faviconUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  faviconKey String?
  faviconSize Int?
  appName String @default("SISMEPDA")
  appFullName String @default("Sistem Informasi Sekolah")
  appLogoData Bytes?
  appLogoMimeType String?
  appLogoUpdatedAt DateTime?
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  appLogoKey String?
  appLogoSize Int?
  schoolName String @default("SMP Negeri 1 Contoh")
  npsn String?
  academicYear String @default("2025/2026")
  semester String @default("Ganjil")
  timeZone String @default("Asia/Jakarta")
  attendanceOpenTime String @default("06:30")
  attendanceCloseTime String @default("08:00")
  autoLock Boolean @default(true)
  allowTeachersAccessAllClasses Boolean @default(false)
  attendanceStatusColors String?
  /// Batas unggah global per kategori, dalam byte. Null berarti "pakai bawaan
  /// kode" (lihat DEFAULT_GLOBAL_LIMITS di lib/upload-policy.ts), bukan tanpa
  /// batas — resolver tidak pernah memperlakukan ketiadaan nilai sebagai izin.
  uploadImageMaxBytes Int?
  uploadDocumentMaxBytes Int?
}

/// Override batas unggah untuk satu Upload Slot.
///
/// Registry slot tetap hidup di kode (lib/upload-slots.ts); tabel ini hanya
/// menyimpan penyimpangan yang dipilih admin. Menyalin seluruh registry ke
/// database akan menciptakan sumber kebenaran kedua yang bisa berbeda pendapat
/// dengan kode saat slot ditambah atau dihapus.
///
/// Baris untuk key yang tidak lagi terdaftar diabaikan resolver, sehingga
/// menghapus slot dari kode tidak pernah melonggarkan apa pun.
model UploadPolicyOverride {
  slotKey String @id
  maxBytes Int
  /// Aktor terakhir yang menyetel nilai ini. Sengaja tanpa relasi ke User agar
  /// menghapus akun tidak menghapus kebijakan sekolah; jejak lengkapnya ada di
  /// AuditLog.
  updatedById String?
  updatedAt DateTime @updatedAt
}

/// Satu entri kalender libur. Tiga tipe dibedakan oleh `kind`:
/// SINGLE memakai `date`; RECURRING memakai `weekday` + `startDate`/`endDate`
/// (`endDate` null = selamanya); SCHOOL_DAY memakai `date` dan membatalkan
/// libur pada tanggal itu. Lihat `lib/holiday-rules.ts`.
model SchoolHoliday {
  id String @id @default(cuid())
  kind HolidayKind @default(SINGLE)
  /// Unik hanya bermakna untuk SINGLE dan SCHOOL_DAY; RECURRING memakai null.
  date DateTime? @db.Date
  name String
  weekday Int?
  startDate DateTime? @db.Date
  endDate DateTime? @db.Date
  createdAt DateTime @default(now())

  @@unique([kind, date])
}

enum HolidayKind {
  SINGLE
  RECURRING
  SCHOOL_DAY
}

model Workbook {
  id String @id @default(cuid())
  number Int @unique
  name String
  weight Int @default(25)
  sortOrder Int
  items WorkbookItem[]
  teacherWorkbooks TeacherWorkbook[]
}

model WorkbookItem {
  id String @id @default(cuid())
  workbookId String
  name String
  sortOrder Int
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  statuses TeacherWorkbookItemStatus[]
  @@unique([workbookId, sortOrder])
  @@index([workbookId])
}

model TeacherWorkbook {
  id String @id @default(cuid())
  userId String
  workbookId String
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workbook Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  @@unique([userId, workbookId])
  @@index([workbookId])
}

model TeacherWorkbookItemStatus {
  id String @id @default(cuid())
  userId String
  workbookItemId String
  status WorkbookItemStatus @default(UNREVIEWED)
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("WorkbookItemStatusTeacher", fields: [userId], references: [id], onDelete: Cascade)
  workbookItem WorkbookItem @relation(fields: [workbookItemId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WorkbookItemStatusReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@unique([userId, workbookItemId])
  @@index([userId])
  @@index([workbookItemId])
}

/** Single-row configuration for the BOS module (mirrors SchoolSetting). */
model BosSetting {
  id String @id @default("default")
  /** Anggaran awal; null selama belum diisi admin. */
  initialBudget Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BosCategory {
  id String @id @default(cuid())
  name String
  /** Lowercase + whitespace-collapsed name; blocks "ATK" / "atk" / " ATK " duplicates. */
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entries BosEntry[]
}

model BosEntry {
  id String @id @default(cuid())
  categoryId String
  description String
  occurredAt DateTime @db.Date
  /** Realisasi rupiah — decimal, never float. */
  amount Decimal @db.Decimal(14, 2)
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category BosCategory @relation(fields: [categoryId], references: [id])
  createdBy User? @relation("BosEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BosEntryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  documents BosDocument[]
  @@index([categoryId])
  @@index([occurredAt])
}

model BosDocument {
  id String @id @default(cuid())
  entryId String
  label String?
  url String
  createdAt DateTime @default(now())
  entry BosEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  @@index([entryId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String
  targetUserId String?
  summary String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entity, entityId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum SarprasPriority {
  HIGH
  MEDIUM
  LOW
}

/// Lokasi sarpras berbentuk tree bebas kedalaman (Gedung > Lantai > Ruang > Area).
/// Sebuah node boleh memiliki child DAN barang sekaligus.
model SarprasLocation {
  id String @id @default(cuid())
  name String
  slug String
  parentId String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent SarprasLocation? @relation("SarprasLocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children SarprasLocation[] @relation("SarprasLocationTree")
  items SarprasItem[]
  /// Nama unik per induk: "VII A" boleh ada di bawah Kelas dan di bawah Gedung B.
  @@unique([parentId, slug])
  @@index([parentId, sortOrder])
}

/// Master jenis barang (CCTV, Proyektor, Kursi Siswa) supaya nama tidak diketik ulang.
model SarprasItemType {
  id String @id @default(cuid())
  name String
  slug String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items SarprasItem[]
}

/// Kebutuhan satu jenis barang pada satu lokasi.
model SarprasItem {
  id String @id @default(cuid())
  locationId String
  itemTypeId String
  targetQuantity Int @default(0)
  availableQuantity Int @default(0)
  goodQuantity Int @default(0)
  moderateQuantity Int @default(0)
  repairQuantity Int @default(0)
  acquisitionDate DateTime? @db.Date
  inventoryCode String?
  description String?
  priority SarprasPriority?
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  location SarprasLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  itemType SarprasItemType @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  createdBy User? @relation("SarprasItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SarprasItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  photos SarprasPhoto[]
  histories SarprasHistory[]
  /// Satu baris per jenis barang per lokasi; perubahan jumlah cukup di-update.
  @@unique([locationId, itemTypeId])
  @@index([locationId])
  @@index([itemTypeId])
}

/// Foto barang disimpan sebagai bytes, mengikuti pola User.photoData.
model SarprasPhoto {
  id String @id @default(cuid())
  itemId String
  /// Historisnya NOT NULL. Dilonggarkan menjadi nullable — bukan dihapus —
  /// karena tanpa itu setiap unggahan Sarpras baru tetap wajib menulis bytea.
  /// Melonggarkan constraint tidak menyentuh satu pun baris yang sudah ada.
  data Bytes?
  mimeType String
  /// Kunci media kanonik; kolom bytes di atas DIPERTAHANKAN sebagai fallback.
  mediaKey String?
  mediaSize Int?
  caption String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([itemId, sortOrder])
}

/// Riwayat perubahan jumlah/kondisi satu barang, untuk panel detail.
model SarprasHistory {
  id String @id @default(cuid())
  itemId String
  actorId String?
  summary String
  before Json?
  after Json?
  createdAt DateTime @default(now())
  item SarprasItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User? @relation("SarprasHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([itemId, createdAt])
}

/// ---------------------------------------------------------------------------
/// RBAC (Phase 2 — foundation additive)
///
/// Tabel di bawah ini ADITIF: belum ada guard produksi yang membacanya. Kolom
/// legacy (`User.role`, kolom boolean kapabilitas, `workbookSupervised`) tetap
/// menjadi otoritas runtime sampai Phase 4. Lihat docs/architecture/rbac.md.
/// ---------------------------------------------------------------------------

/// Sekumpulan permission bernama. User memegang 0..n role; tidak ada role
/// default implisit dan tidak ada hierarki/inheritance antar role.
///
/// Nama fisiknya `RbacRole`, bukan `Role`, karena tipe enum PostgreSQL `"Role"`
/// sudah ada sejak migration init dan baru dihapus pada Phase 6.
model Role {
  id          String           @id @default(cuid())
  /// Kunci stabil lowercase (`system_admin`, `guru`). Dipakai kode dan seed
  /// untuk idempotensi; tidak pernah ikut berubah saat `name` diganti admin.
  key         String           @unique
  /// Label tampilan yang boleh diubah admin. Sengaja TIDAK unique dan tidak
  /// pernah dipakai untuk keputusan otorisasi: role bernama "Admin Sistem"
  /// yang key-nya bukan `system_admin` tidak memperoleh keistimewaan apa pun.
  name        String
  description String?
  /// Role bawaan sistem yang di-seed kode. Tidak boleh dihapus.
  isSystem    Boolean          @default(false)
  /// Field identitas (`key`, `isSystem`, `isProtected`) tidak boleh diubah
  /// lewat payload role generik. Hanya `system_admin` yang memperoleh bypass,
  /// dan bypass itu ditentukan oleh `key`, bukan oleh kolom ini — menyalin
  /// role berbendera protected tidak menyalin bypass.
  isProtected Boolean          @default(false)
  /// Optimistic concurrency: update role membandingkan versi, penulisan basi
  /// ditolak 409 alih-alih saling menimpa diam-diam.
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("RbacRole")
}

/// Katalog satu operasi konkret yang benar-benar dicek kode.
///
/// Baris di sini adalah cerminan registry TypeScript (`lib/rbac-permissions.ts`);
/// UI hanya boleh menautkan role ke baris yang sudah ada, tidak pernah mengarang
/// key baru.
model Permission {
  id          String           @id @default(cuid())
  /// Gabungan `resource.action` atau `resource.action.scope`. Redundan
  /// terhadap tiga kolom di bawah, tetapi disimpan supaya lookup dan seed
  /// cukup memakai satu kolom.
  key         String           @unique
  resource    String
  action      String
  /// Null berarti permission tidak berskala (school-wide), bukan "semua scope".
  scope       String?
  label       String
  description String?
  /// Pengelompokan untuk UI, mis. `attendance`, `euks`.
  module      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  /// Menjamin `key` benar-benar turunan tiga kolom ini: satu kombinasi
  /// resource+action+scope tidak boleh muncul dua kali dengan key berbeda.
  @@unique([resource, action, scope])
  @@index([module])
}

/// Keanggotaan user pada role. Tidak ada grant permission langsung ke user.
model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

/// Permission yang dimiliki sebuah role. Tidak ada DENY — ketiadaan baris
/// berarti tidak diberikan.
model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Status satu pekerjaan migrasi RBAC one-time (mis. backfill akses legacy).
enum RbacMigrationStatus {
  RUNNING
  FAILED
  COMPLETED
}

/// Penanda persisten migrasi RBAC. Satu baris per pekerjaan migrasi; dipakai
/// sebagai sumber status kesiapan (`readiness`) aplikasi RBAC dan sebagai
/// idempotency marker: setelah COMPLETED, backfill tidak boleh dijalankan
/// ulang sehingga grant yang dicabut admin tidak pernah dipulihkan diam-diam.
model RbacMigration {
  key         String              @id
  status      RbacMigrationStatus
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  lastError   String?
  /// Ringkasan angka hasil migrasi/paritas. Tidak pernah memuat kredensial.
  report      Json?
  updatedAt   DateTime            @updatedAt
  items       RbacMigrationItem[]
}

/// Unit kerja migrasi yang sudah selesai (per akun) sehingga percobaan ulang
/// sebelum COMPLETED hanya memproses akun yang belum tuntas.
model RbacMigrationItem {
  migrationKey String
  userId       String
  completedAt  DateTime      @default(now())
  migration    RbacMigration @relation(fields: [migrationKey], references: [key], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([migrationKey, userId])
  @@index([userId])
}

/// Jenis pesan WhatsApp otomatis. Sengaja enum, bukan string bebas: nama jenis
/// ikut menyusun idempotency key, jadi salah ketik akan mengizinkan kiriman
/// ganda pada slot yang sama.
enum WhatsAppMessageType {
  /// Daftar kelas yang belum mengisi/melengkapi absensi hari itu (08.00, 10.00).
  ATTENDANCE_MISSING
  /// Rekap siswa tidak hadir hari itu (12.00).
  ATTENDANCE_ABSENT
}

/// Bagaimana sebuah pengiriman dipicu. Riwayat WAJIB bisa membedakan keduanya:
/// kiriman terjadwal dijaga idempotensi, kiriman manual sengaja boleh berulang.
enum WhatsAppSendTrigger {
  SCHEDULED
  MANUAL
}

enum WhatsAppSendStatus {
  /// Occurrence sudah DIKLAIM tetapi transport belum menjawab. Ditulis SEBELUM
  /// pesan dikirim: klaim inilah yang menghentikan duplikat, bukan pencatatan
  /// sesudahnya. Baris yang tertinggal di status ini berarti proses mati di
  /// tengah pengiriman — dan memang tidak boleh dikirim ulang otomatis, karena
  /// pesan pertama mungkin sudah sampai.
  PROCESSING
  SENT
  FAILED
  /// Tidak dikirim karena keputusan sadar (hari libur, toggle nonaktif, slot
  /// terlewat). Bukan kegagalan, tetapi tetap dicatat agar admin tahu alasannya.
  SKIPPED
}

/// Dari mana sebuah jenis pesan mengambil grup tujuannya.
///
/// Sengaja enum dua nilai, bukan "JID kosong berarti default": tujuan yang
/// belum dipilih dan tujuan yang sengaja mengikuti default adalah dua keadaan
/// berbeda, dan hanya yang pertama boleh menghalangi pengaktifan otomatis.
enum WhatsAppDestinationMode {
  /// Ikut "Grup tujuan default". Berubahnya default ikut mengubah tujuan ini.
  DEFAULT
  /// Memakai grup sendiri, terlepas dari default.
  OVERRIDE
}

/// Setelan WhatsApp yang berlaku lintas jenis pesan. Satu baris (mirip
/// SchoolSetting/BosSetting).
///
/// Grup default tinggal di sini, bukan diduplikasi ke setiap baris
/// WhatsAppConfiguration: menyalinnya per jenis berarti mengubah default harus
/// menyentuh N baris, dan satu baris yang terlewat mengirim rekap sekolah ke
/// grup yang salah tanpa ada yang menyadarinya.
model WhatsAppSetting {
  id String @id @default("default")
  /// JID grup (`...@g.us`) tujuan default — identifier kanonik.
  defaultGroupJid String?
  /// Nama grup saat terakhir dilihat. Display saja; nama grup bisa berubah
  /// sewaktu-waktu dan tidak pernah dipakai memilih tujuan.
  defaultGroupName String?
  defaultGroupResolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Konfigurasi per jenis pesan otomatis. Satu baris per `type`.
///
/// Jam jadwal TIDAK disimpan di sini: ia tinggal di satu tempat di kode
/// (`lib/whatsapp-schedule.ts`) supaya tidak tersebar sebagai magic number.
/// Baris ini menyimpan hal yang memang milik operator: aktif/nonaktif dan
/// tujuan yang sudah di-resolve.
model WhatsAppConfiguration {
  /// Satu baris per jenis pesan, jadi jenisnya sekaligus primary key.
  type WhatsAppMessageType @id
  /// Toggle pengiriman OTOMATIS. Tidak pernah menghalangi "Kirim sekarang":
  /// kiriman manual adalah tindakan eksplisit admin.
  enabled Boolean @default(false)
  /// Apakah jenis ini mengikuti grup default atau memakai grupnya sendiri.
  /// Default `DEFAULT` agar jenis pesan baru otomatis ikut grup default dan
  /// tidak diam-diam menjadi "belum punya tujuan".
  destinationMode WhatsAppDestinationMode @default(DEFAULT)
  /// JID grup tujuan (`...@g.us`) — identifier kanonik. Nama grup bisa berubah
  /// atau ganda, jadi pengiriman SELALU memakai JID ini, tidak pernah mencari
  /// ulang berdasarkan nama pada setiap kiriman.
  targetGroupJid String?
  /// Nama grup saat terakhir di-resolve. Untuk tampilan saja; tidak pernah
  /// dipakai memilih tujuan.
  targetGroupName String?
  targetResolvedAt DateTime?
  /// Jam pengiriman `HH:mm` dalam zona waktu sekolah, menaik dan tanpa kembar.
  /// Dahulu jam ini hidup sebagai konstanta di source code; memindahkannya ke
  /// sini membuat admin dapat mengubah jadwal tanpa rilis baru. Nilainya ikut
  /// menyusun idempotency key, jadi ia kontrak, bukan preferensi tampilan.
  slots String[]
  /// Template pesan yang disunting admin, per KONDISI (lihat
  /// `WhatsAppTemplateKey`). NULL berarti "belum pernah disunting" dan jenis
  /// ini memakai template bawaan di `lib/whatsapp-template-defaults.ts`.
  ///
  /// MENGAPA JSON, BUKAN TABEL SENDIRI
  ///
  /// Isinya selalu dibaca dan ditulis sekaligus sebagai satu kesatuan milik
  /// satu jenis pesan, tidak pernah di-query per kondisi. Tabel terpisah hanya
  /// menambah join tanpa menambah kemampuan. Bentuknya divalidasi zod pada
  /// setiap pembacaan, sehingga baris lama maupun baris rusak tidak pernah
  /// sampai ke penyusun pesan.
  ///
  /// NULL adalah keadaan yang sah dan permanen: instalasi yang tidak pernah
  /// menyentuh template harus tetap mengirim pesan seperti sebelumnya.
  messageTemplates Json?
  /// Waktu pesan jenis ini terakhir BERHASIL terkirim, lewat jalur mana pun.
  lastSentAt DateTime?
  updatedAt DateTime @updatedAt
  sendLogs WhatsAppSendLog[]
}

/// Satu baris per percobaan pengiriman, berhasil maupun gagal.
///
/// Isi pesan disimpan sebagai snapshot, bukan nama template: data absensi
/// berubah setelah pesan terkirim, jadi merender ulang nanti akan menghasilkan
/// teks yang berbeda dari yang benar-benar dibaca orang di grup.
model WhatsAppSendLog {
  id String @id @default(cuid())
  type WhatsAppMessageType
  trigger WhatsAppSendTrigger
  status WhatsAppSendStatus
  /// Kunci logis slot terjadwal, mis. `attendance_missing:2026-09-15:08:00`.
  /// UNIQUE — inilah penjaga duplikat yang sesungguhnya: dua worker, retry
  /// scheduler, atau restart tidak dapat menembus constraint database.
  /// NULL untuk kiriman manual, yang memang boleh berulang (PostgreSQL
  /// memperlakukan setiap NULL sebagai berbeda).
  idempotencyKey String? @unique
  /// Tanggal sekolah yang dilaporkan pesan ini (DATE, bebas timezone).
  schoolDate DateTime @db.Date
  /// Slot jadwal `HH:mm` untuk kiriman terjadwal; NULL untuk manual.
  scheduledSlot String?
  targetGroupJid String?
  /// Nama grup pada saat kirim; snapshot, karena nama grup bisa berubah.
  targetGroupName String?
  /// Teks persis yang dikirim (atau yang akan dikirim saat gagal).
  messageText String
  /// ID pesan dari transport bila tersedia. Bukan rahasia.
  providerMessageId String?
  /// Kategori kegagalan yang stabil untuk kode/UI (mis. `NOT_CONNECTED`).
  errorCode String?
  /// Pesan yang aman ditampilkan ke admin. TIDAK PERNAH berisi kredensial,
  /// isi sesi, atau stack trace mentah.
  errorMessage String?
  attemptedAt DateTime @default(now())
  sentAt DateTime?
  /// Admin yang menekan "Kirim sekarang". NULL untuk kiriman terjadwal.
  initiatedById String?
  initiatedBy User? @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  configuration WhatsAppConfiguration @relation(fields: [type], references: [type], onDelete: Cascade)
  @@index([attemptedAt])
  @@index([type, attemptedAt])
  @@index([schoolDate])
}

/// ---------------------------------------------------------------------------
/// MODUL JADWAL
///
/// Empat hal sengaja DIPISAH (lihat docs/features/jadwal.md):
///   * WAKTU        — ScheduleTimeProfile/ScheduleTimeSlot: pukul berapa
///     "Jam ke-1" berlangsung. Otoritas SISMEPDA, bukan XML aSc.
///   * JADWAL       — ScheduleRevision/ScheduleEntry: siapa mengajar apa, di
///     kelas mana, hari apa, jam ke berapa. Selalu relasi ID, tidak pernah nama.
///   * MAPPING      — ScheduleExternalMapping: entity aSc mana merujuk entity
///     SISMEPDA mana. Persisten, berbasis external ID, bukan pencocokan nama.
///   * IMPOR        — ScheduleImport: berkas yang sudah di-parse, menunggu
///     konfirmasi admin. Tidak pernah menyentuh jadwal aktif sebelum Apply.
/// ---------------------------------------------------------------------------

/// Jenis satu baris pada struktur waktu harian.
enum ScheduleSlotKind {
  /// Jam pelajaran; satu-satunya jenis yang boleh punya `ascPeriod`.
  PELAJARAN
  ISTIRAHAT
  /// Pembiasaan, upacara, apel, dan kegiatan non-pelajaran lain.
  KEGIATAN
}

/// Profil waktu harian (mis. Reguler, Ramadan). Tepat satu baris `active`;
/// keunikannya ditegakkan transaksi, bukan constraint parsial, supaya
/// mengganti profil aktif tidak pernah butuh window tanpa profil aktif.
///
/// Sebuah profil TIDAK memiliki satu struktur generik: strukturnya selalu
/// dimiliki sebuah HARI (`ScheduleProfileDay`), karena Jumat sah memiliki jam
/// ke-1 yang lebih pendek daripada Senin.
model ScheduleTimeProfile {
  id        String              @id @default(cuid())
  /// Kunci stabil lowercase, dipakai seed/idempotensi.
  key       String              @unique
  name      String
  active    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  days      ScheduleProfileDay[]
  slots     ScheduleTimeSlot[]

  @@index([active])
}

/// Konfigurasi satu hari pada sebuah profil waktu.
///
/// Hari disimpan sebagai BARIS, bukan enam kolom: sekolah boleh menambah atau
/// menghapus hari aktif tanpa migrasi. `day` adalah representasi internal yang
/// stabil (1 = Senin .. 7 = Minggu, sama dengan `ScheduleEntry.day`), bukan
/// label tampilan — label boleh berubah tanpa memindahkan data.
model ScheduleProfileDay {
  id        String              @id @default(cuid())
  profileId String
  /// 1 = Senin .. 7 = Minggu. Unik per profil.
  day       Int
  /// Urutan tampil pemilih hari; tidak harus sama dengan `day`.
  position  Int
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  profile   ScheduleTimeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slots     ScheduleTimeSlot[]

  @@unique([profileId, day])
  @@index([profileId])
}

/// Satu baris pada struktur waktu SATU HARI: urutan, jenis, nama, mulai, selesai.
///
/// Waktu disimpan sebagai MENIT SEJAK TENGAH MALAM (0..1439), bukan DateTime:
/// ini jam dinding sekolah yang berlaku setiap hari, sehingga menyimpannya
/// sebagai timestamp akan menyeret tanggal dan zona waktu ke dalam data yang
/// sama sekali tidak memilikinya.
model ScheduleTimeSlot {
  id          String              @id @default(cuid())
  /// Profil pemilik. Denormalisasi yang disengaja: dipertahankan dari model
  /// lama supaya kueri "semua slot profil ini" tetap satu langkah.
  profileId   String
  dayId       String
  /// Urutan tampil dalam satu hari. Unik per hari.
  position    Int
  kind        ScheduleSlotKind
  name        String
  startMinute Int
  endMinute   Int
  /// Nomor period aSc untuk slot PELAJARAN. Null untuk istirahat/kegiatan.
  /// Inilah jembatan tunggal antara `card.period` XML dan jam dinding sekolah.
  /// Unik per HARI, bukan per profil: period 1 boleh ada di setiap hari dengan
  /// jam dinding yang berbeda.
  ascPeriod   Int?
  profile     ScheduleTimeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayConfig   ScheduleProfileDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, position])
  @@unique([dayId, ascPeriod])
  @@index([profileId])
  @@index([dayId])
}

/// Template struktur waktu: sumber SALINAN, bukan referensi hidup.
///
/// Template sengaja TIDAK punya relasi ke `ScheduleProfileDay`. Menerapkan
/// template menyalin barisnya; setelah itu hari berdiri sendiri, sehingga
/// mengedit atau menghapus template tidak pernah mengubah jadwal hari mana pun.
model ScheduleTimeTemplate {
  id        String                     @id @default(cuid())
  name      String                     @unique
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  slots     ScheduleTimeTemplateSlot[]

  @@index([updatedAt])
}

/// Satu baris isi template. Bentuknya cerminan `ScheduleTimeSlot` supaya
/// validasi yang sama berlaku untuk template dan untuk hari.
model ScheduleTimeTemplateSlot {
  id          String               @id @default(cuid())
  templateId  String
  position    Int
  kind        ScheduleSlotKind
  name        String
  startMinute Int
  endMinute   Int
  ascPeriod   Int?
  template    ScheduleTimeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@unique([templateId, ascPeriod])
  @@index([templateId])
}

/// Asal sebuah revisi jadwal.
enum ScheduleRevisionSource {
  ASC_IMPORT
  MANUAL
  ROLLBACK
}

/// Satu versi lengkap jadwal sekolah. Tepat satu baris `active`.
///
/// Snapshot penuh per revisi dipilih dengan sadar: satu revisi ≈ jumlah slot
/// mengajar satu sekolah (ribuan baris kecil berisi ID saja), sementara diff
/// inkremental akan membuat "jadwal Rabu" hanya dapat dijawab dengan memutar
/// ulang seluruh riwayat. Rollback menjadi penyalinan satu snapshot.
model ScheduleRevision {
  id        String                 @id @default(cuid())
  /// Nomor urut manusiawi ("Versi 4"). Unik, naik monoton.
  number    Int                    @unique
  source    ScheduleRevisionSource
  active    Boolean                @default(false)
  note      String?
  /// Ringkasan angka (jumlah entri, +/~/- terhadap revisi sebelumnya).
  /// Tidak pernah memuat isi berkas XML.
  summary   Json?
  createdById String?
  createdAt DateTime               @default(now())
  createdBy User?                  @relation("ScheduleRevisionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  entries   ScheduleEntry[]
  imports   ScheduleImport[]

  @@index([active])
  @@index([createdAt])
}

/// Satu penempatan: guru X mengajar mapel Y di kelas Z, hari H, jam ke-P.
///
/// `period` adalah nomor period (sama dengan `ScheduleTimeSlot.ascPeriod`),
/// BUKAN pukul. Jam dinding selalu diresolusi lewat profil waktu aktif.
model ScheduleEntry {
  id         String           @id @default(cuid())
  revisionId String
  /// 1 = Senin .. 6 = Sabtu, mengikuti konvensi TeachingAssignment.day.
  day        Int
  period     Int
  classId    String
  subjectId  String
  /// Guru pengampu. Null berarti slot terisi tanpa guru yang dapat dipetakan
  /// (impor aSc dengan guru belum termapping) — bukan "kosong".
  teacherId  String?
  room       String?
  revision   ScheduleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    User?            @relation("ScheduleEntryTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  /// Satu kelas tidak boleh punya dua pelajaran pada slot yang sama. Bentrok
  /// guru TIDAK dijadikan constraint database karena satu guru sah mengajar
  /// kelas gabungan; penegakannya ada di lapisan aplikasi dengan pesan yang
  /// menyebut bentrokannya.
  @@unique([revisionId, day, period, classId])
  @@index([revisionId, teacherId, day, period])
  @@index([revisionId, day, period])
}

/// Sumber data eksternal yang boleh dipetakan ke entity SISMEPDA.
enum ScheduleExternalSource {
  ASC_TIMETABLES
}

/// Jenis entity yang dipetakan.
enum ScheduleExternalEntity {
  TEACHER
  CLASS
  SUBJECT
}

/// Pemetaan persisten external ID → ID internal.
///
/// Inilah alasan nama boleh typo di XML: pencocokan nama hanya dipakai untuk
/// MENYARANKAN, sedangkan yang disimpan dan dipakai impor berikutnya adalah
/// pasangan ID. `externalName` disimpan hanya sebagai keterangan tampilan dan
/// tidak pernah menimpa nama resmi Data Master.
model ScheduleExternalMapping {
  id           String                 @id @default(cuid())
  source       ScheduleExternalSource
  entityType   ScheduleExternalEntity
  externalId   String
  internalId   String
  externalName String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([source, entityType, externalId])
  @@index([source, entityType, internalId])
}

/// Status satu berkas impor.
enum ScheduleImportStatus {
  /// Sudah di-parse dan divalidasi, menunggu konfirmasi admin.
  PREVIEW
  APPLIED
  CANCELLED
  FAILED
}

/// Satu upaya impor aSc.
///
/// Byte XML mentah TIDAK disimpan: yang dibutuhkan Apply hanyalah hasil parse
/// yang sudah dinormalkan (`payload`), sehingga tidak ada berkas pengguna yang
/// menumpuk di database dan tidak ada kolom biner baru (lihat
/// docs/architecture/media-storage.md).
model ScheduleImport {
  id           String               @id @default(cuid())
  fileName     String
  fileSize     Int
  status       ScheduleImportStatus @default(PREVIEW)
  /// Hasil parse ternormalisasi: daftar guru/kelas/mapel eksternal dan
  /// penempatan (day, period, externalId). Bukan berkas aslinya.
  payload      Json
  /// Ringkasan preview terakhir yang dihitung untuk berkas ini.
  summary      Json?
  error        String?
  uploadedById String?
  createdAt    DateTime             @default(now())
  appliedAt    DateTime?
  /// Revisi yang dihasilkan bila impor ini jadi diterapkan.
  revisionId   String?
  uploadedBy   User?                @relation("ScheduleImportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  revision     ScheduleRevision?    @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
}
