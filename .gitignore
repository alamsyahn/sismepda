dev.db*
app/generated/prisma/

# Penyimpanan media runtime (MEDIA_STORAGE_ROOT). Berisi foto nyata warga
# sekolah dan tidak pernah boleh masuk Git; produksi memakai volume terpisah.
.media/
.media-backups/

# Salinan lokal manifest set backup produksi. Berisi metadata backup nyata
# (nama host, path, ukuran) dan tidak pernah boleh masuk Git.
.backup-sets/

# Sesi/kredensial WhatsApp (Baileys). Siapa pun yang memegang isinya dapat
# mengirim pesan sebagai akun sekolah: tidak pernah boleh masuk Git. Produksi
# menyimpannya di volume Docker terpisah, bukan di dalam image.
.whatsapp-session/

