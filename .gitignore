# Area kerja dump clone produksi (db:refresh-prodclone). Berisi data siswa
# nyata: tidak boleh masuk Git dalam bentuk apa pun.
.prodclone/
/*.sql
*.backup
*.db
*.sqlite
*.sqlite3
